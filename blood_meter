  <div class="result-area">
    <!-- <div class="result-label">&#128202; &#1056;&#1077;&#1079;&#1091;&#1083;&#1100;&#1090;&#1072;&#1090; (&#1074;&#1099;&#1074;&#1086;&#1076;)</div> -->

  <h1>РАСЧЕТ ДОЗЫ ИНСУЛИНА</h1>
  <!-- <div class="sub">&#1055;&#1088;&#1072;&#1074;&#1080;&#1083;&#1086; &#1087;&#1077;&#1088;&#1077;&#1089;&#1095;&#1077;&#1090;&#1072; &#8212; &#1085;&#1080;&#1078;&#1077;</div> -->

  <div class="input-group">
    <!-- <label for="numericInput">&#128221; &#1042;&#1074;&#1077;&#1076;&#1080;&#1090;&#1077; &#1095;&#1080;&#1089;&#1083;&#1086; X</label> -->
	<label for="numericInput">&#128221; Введите показания глюкометра</label>
    <input type="number" id="numericInput" class="number-input" 
           inputmode="numeric" pattern="\d*" 
           placeholder="&#1053;&#1072;&#1087;&#1088;&#1080;&#1084;&#1077;&#1088;: 5.5"
           autocomplete="off"
           enterkeyhint="done"
           step="any">

  <button class="clear-btn" id="clearButton" aria-label="&#1054;&#1095;&#1080;&#1089;&#1090;&#1080;&#1090;&#1100; &#1087;&#1086;&#1083;&#1077;">
    &#10006;&#65039; &#1054;&#1095;&#1080;&#1089;&#1090;&#1080;&#1090;&#1100;
  </button>

  <!-- <div class="info-note">

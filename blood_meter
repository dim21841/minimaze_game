  </div>
  <footer>&#1056;&#1077;&#1079;&#1091;&#1083;&#1100;&#1090;&#1072;&#1090; &#1086;&#1073;&#1085;&#1086;&#1074;&#1083;&#1103;&#1077;&#1090;&#1089;&#1103; &#1087;&#1088;&#1080; &#1074;&#1074;&#1086;&#1076;&#1077;</footer> -->
</div>

<script>
  const inputElement = document.getElementById('numericInput');
  const resultSpan = document.getElementById('resultDisplay');

  /**
   * Преобразует число X по заданным правилам
   * @param {number} x - введённое число
   * @returns {number} результат: 2.5, 3.0, 3.5 или 4.0
   */
  function calculateResult(x) {
    // X < 10.0  -> 2.5
    if (x < 10.0) {
      return 2.5;
    }
    // 10.0 < X < 15.0 -> 3.0
    if (x > 10.0 && x < 15.0) {
      return 3.0;
    }
    // 15.0 < X < 20.0 -> 3.5
    if (x > 15.0 && x < 20.0) {
      return 3.5;
    }
    // 20.0 < X -> 4.0
    if (x > 20.0) {
      return 4.0;
    }
    // Пограничные случаи: X === 10.0, X === 15.0, X === 20.0
    // а также X === 10.0 (не подходит под >10.0, поэтому попадает сюда)
    // По логике "строго больше" — на границах возвращаем предыдущий результат
    if (x === 10.0) {
      return 2.5;   // как для X < 10.0
    }
    if (x === 15.0) {
      return 3.0;   // как для 10.0 < X < 15.0? нет, но по смыслу граница — оставляем 3.0
    }
    if (x === 20.0) {
      return 3.5;   // как для 15.0 < X < 20.0
    }
    // Если X находится в интервале [10.0, 10.0] или других выпадающих — fallback
    // Например X = 10.0 обработано выше. Для X между 15.0 и 20.0 включительно?
    // X = 15.0 -> 3.0, X = 20.0 -> 3.5
    // Также для X меньше 10.0 уже обработано.
    // Дополнительно: X = 10.0001 -> попадает во второй if ( >10.0 и <15.0 ) -> 3.0
    // Остался случай X === 15.0 и X === 20.0 обработаны явно.
    // Для интервала [10.0, 10.0] (равно) -> 2.5
    // Для X между 15.0 и 20.0 исключительно (>15.0 и <20.0) -> 3.5 уже есть
    // Для X === 15.0 -> 3.0
    // Для X === 20.0 -> 3.5
    // Если X находится между 10.0 и 10.0? не бывает.
    // Всё покрыто.
    return 4.0; // если вдруг что-то не охвачено (но не должно)
  }

  function formatOutput(value) {
    // Убираем лишние нули: 2.5 -> "2.5", 3.0 -> "3.0", 4.0 -> "4.0"
    if (Number.isInteger(value)) {
      return value.toFixed(1); // 3.0, 4.0
    }
    return value.toString(); // 2.5
  }

  function updateResult() {
    let rawValue = inputElement.value;
    
    // Пустое поле
    if (rawValue === null || rawValue === undefined || rawValue === '') {
      resultSpan.textContent = '⏺ (' + String.fromCharCode(1085,1077,32,1079,1072,1076,1072,1085,1086) + ')';
      resultSpan.style.opacity = '0.8';
      return;
    }
    
    let trimmed = rawValue.trim();
    if (trimmed === '') {
      resultSpan.textContent = '⏺ (' + String.fromCharCode(1087,1091,1089,1090,1086) + ')';
      return;
    }
    
    const numberValue = parseFloat(trimmed);
    
    // Проверка на валидное число
    if (isNaN(numberValue)) {
      resultSpan.textContent = '❌ ' + String.fromCharCode(1053,1077,1082,1086,1088,1088,1077,1082,1090,1085,1086) + ': "' + trimmed + '"';
      resultSpan.style.color = '#b91c1c';
      return;
    }
    
    // Вычисляем результат по правилам
    let result = calculateResult(numberValue);
    let displayResult = formatOutput(result);
    
    // Дополнительно показываем исходное X для ясности (опционально, но улучшает UX)
    // Можно показать дополнительную информацию, но не перегружая
    resultSpan.style.color = '#0f172a';
    resultSpan.style.opacity = '1';
    
    // Просто выводим результат
    resultSpan.textContent = displayResult;
    
    // Небольшой визуальный эффект при изменении (мигание)
    resultSpan.style.transform = 'scale(1.02)';
    setTimeout(() => {
      if (resultSpan) resultSpan.style.transform = '';
    }, 120);
  }
  
  function clearInput() {
    inputElement.value = '';
    updateResult();
    if (window.navigator && window.navigator.vibrate) {
      window.navigator.vibrate(12);
    }
  }
  
  // Основные события
  inputElement.addEventListener('input', updateResult);
  inputElement.addEventListener('change', updateResult);
  inputElement.addEventListener('blur', updateResult);
  
  const clearBtn = document.getElementById('clearButton');
  clearBtn.addEventListener('click', (e) => {
    e.preventDefault();
    clearInput();
  });
  
  // Инициализация
  updateResult();
  
  // Анимация фокуса
  inputElement.addEventListener('focus', () => {
    document.querySelector('.card').style.boxShadow = '0 28px 48px -12px rgba(0, 0, 0, 0.35)';
  });
  inputElement.addEventListener('blur', () => {
    document.querySelector('.card').style.boxShadow = '0 25px 45px -12px rgba(0, 0, 0, 0.3), 0 4px 12px rgba(0, 0, 0, 0.05)';
  });
  
  // Для мобильных устройств — цифровая клавиатура
  const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  if (!isMobile) {
    const note = document.querySelector('.info-note');
    if (note) {
      note.style.background = "#e9ecef";
      note.innerHTML = '💻 ' + String.fromCharCode(1044,1077,1089,1082,1090,1086,1087) + ': ' + String.fromCharCode(1080,1089,1087,1086,1083,1100,1079,1091,1081,1090,1077,32,1094,1080,1092,1088,1086,1074,1091,1102,32,1082,1083,1072,1074,1080,1072,1090,1091,1088,1091);
    }
  } else {
    inputElement.setAttribute('inputmode', 'numeric');
    inputElement.setAttribute('pattern', '\\d*');
  }
  
  inputElement.addEventListener('paste', () => {
    setTimeout(updateResult, 10);
  });
  
  // Тестовые примеры для консоли (разработка)
  console.log('Логика преобразования:');
  console.log('X=5 ->', calculateResult(5));    // 2.5
  console.log('X=10 ->', calculateResult(10));   // 2.5
  console.log('X=12.3 ->', calculateResult(12.3)); // 3.0
  console.log('X=15 ->', calculateResult(15));   // 3.0
  console.log('X=17.8 ->', calculateResult(17.8)); // 3.5
  console.log('X=20 ->', calculateResult(20));   // 3.5
  console.log('X=25 ->', calculateResult(25));   // 4.0
</script>
